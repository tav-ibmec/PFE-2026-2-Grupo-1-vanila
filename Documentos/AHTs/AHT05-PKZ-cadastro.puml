@startuml AHT05-PKZ-cadastro
skinparam DefaultTextAlignment center
title AHT 05: Cadastro PKZ Lab

note right
  Fluxo de cadastro da PKZ Lab, acessado a partir da AHT 03
end note


start

#5B9BD5:Usuário chega à página de Cadastro da PKZ Lab;
#5B9BD5:Sistema exibe formulário para o cadastro do responsável, dependente (aluno) e a escolha do plano;
repeat
  #lightyellow:Preencheu o formulário e escolheu o plano;
  #lightyellow:Clicou em "Selecionar";

  if (Cadastro processado com sucesso?) then (sim)
    #5B9BD5:Sistema exibe "Cadastro realizado com sucesso!";
    break
  else (não)
    #5B9BD5:Sistema exibe "Não foi possível concluir o cadastro, Verifique os dados e tente novamente";
    #5B9BD5:Retornar ao formulário de cadastro;
  endif
repeat while (Deseja tentar novamente?) is (sim)
->não;


legend right
  |Cor | Significado|
  |<#5B9BD5>| Ação ou tela exibida pelo sistema |
  |<#lightyellow>| Resultado de uma decisão do usuário |
endlegend

stop
@enduml